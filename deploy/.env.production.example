# انسخ هذا الملف إلى <جذر المستودع>/.env وعدّل القيم قبل docker compose up
POSTGRES_DB=newport
POSTGRES_USER=newport
POSTGRES_PASSWORD=CHANGE-ME-strong-password
JWT_SECRET=CHANGE-ME-32-bytes-or-more-random
FACILITY_CODE=BFC-L1
NODE_ENV=production
CORS_ORIGINS=https://ops.newport.local
PUBLIC_BASE_URL=https://ops.newport.local
SEED_DEMO=false
BACKUP_RETENTION_DAYS=30

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/documents
STORAGE_MAX_UPLOAD_BYTES=8388608   # 8 MiB بعد فك الترميز؛ nginx يسمح حتى 40m
