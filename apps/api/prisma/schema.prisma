  labor        WoLaborEntry[]
  logs         WoLog[]
  readings     AssetReading[]

  @@index([subDeptId, status, priority])
  @@index([assetId, status])
  @@index([status, targetEndAt])
  @@index([createdById])
  @@index([permitId])
  @@index([syncSeq])
  @@map("work_orders")
}

enum WoStatus {
  DRAFT
