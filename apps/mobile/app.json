{
  "expo": {
    "name": "Newport Field",
    "slug": "newport-field",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "newportfield",
    "userInterfaceStyle": "dark",
    "locales": { "./assets/locales/ar.json": "./assets/locales/ar.json" },
    "extra": { "facilityCode": "BFC-L1" },
    "android": {
      "package": "com.newport.field",
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "INTERNET", "READ_MEDIA_IMAGES"],
      "adaptiveIcon": { "backgroundColor": "#0f1720" }
    },
    "ios": {
      "bundleIdentifier": "com.newport.field",
      "infoPlist": {
        "NSCameraUsageDescription": "تصوير الأعطال والمعدات لإرفاقها بأوامر العمل",
        "NSLocationWhenInUseUsageDescription": "تسجيل موقع الجولة الميدانية مع البصمة الزمنية"
      }
    },
    "plugins": ["expo-sqlite"],
    "updates": { "url": "https://updates.newport.local/mobile", "fallbackToCacheTimeout": 0 }
  }
}
