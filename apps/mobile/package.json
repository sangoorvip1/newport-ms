{
  "name": "@newport/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "description": "Android/iOS field client (Expo + React Native) — offline-first via expo-sqlite + shared sync core",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios"
  },
  "dependencies": {
    "@newport/domain": "*",
    "expo": "57.0.20",
    "expo-sqlite": "57.0.2",
    "react": "19.2.8",
    "react-native": "0.87.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
